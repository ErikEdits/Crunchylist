# Example nginx reverse-proxy config for Watchlog.
#
# 1. Point your domain's DNS A/AAAA record at this server's IP.
# 2. Save this file to /etc/nginx/sites-available/watchlog and symlink it into
#    sites-enabled, then `nginx -t && systemctl reload nginx`.
# 3. Get a free TLS certificate:  certbot --nginx -d watchlog.example.com
# 4. Set BASE_URL=https://watchlog.example.com in the app's config/env.

server {
    listen 80;
    server_name watchlog.example.com;   # <-- your domain

    # Allow uploads a little larger than the app's MAX_UPLOAD_MB.
    client_max_body_size 20m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
